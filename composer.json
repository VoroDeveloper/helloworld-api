{
    "name": "vorodeveloper/helloworld-api",
    "description": "Standard REST API in pure PHP for multilingual greetings",
    "type": "project",
    "license": "Apache-2.0",
    "homepage": "https://vorodev.com",
    "authors": [
        {
            "name": "VoroDeveloper",
            "homepage": "https://vorodeveloper.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
