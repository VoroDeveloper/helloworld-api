# Use UTF-8 as the default charset for text/plain and text/html responses
# and associate it with these static file types
AddDefaultCharset UTF-8
AddCharset UTF-8 .yaml .yml .json .html

# Prevent directory listings
Options -Indexes

# Prevent Apache from guessing alternative paths based on file extensions or names
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Deny access to files whose names begin with a dot (e.g., .env, .htaccess)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

# Prevent MIME sniffing and add an authorship reference
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header always set Link "<https://vorodeveloper.com/>; rel=author"
</IfModule>

# Internally rewrite API routes to the front controller
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve the Authorization header for possible future token-based authentication
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Internally rewrite requests that do not match a real file or directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
